#!/bin/bash

################################
# Match Data Ingestion - Deploy #
################################

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"
SERVICE_NAME_UPDATER="match-updater"
SERVICE_NAME_INGESTION="match-data-ingestion"
REGION="${REGION:-europe-southwest1}"
REPOSITORY="${REPOSITORY:-services}"
IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${SERVICE_NAME_INGESTION}"
