<file path=".github/workflows/cd-cloud-run-service.yaml">
name: Deploy Service to GCP Cloud Run
run-name: "Deploy to Cloud Run ${{ inputs.service-name }}"

on:
  workflow_dispatch:
    inputs:
      service-name:
        type: string
        description: "The name identifying the service in the Cloud Run console"
        default: events-service
      build-mode:
        type: choice
        description: "The build mode to use for the Docker image"
        options:
          - jvm
          - native
        default: native
      github-service-repository:
        required: true
        type: string
        description: "The repository containing the source code for the service"
      github-org:
        required: true
        type: string
        description: "The GitHub organization containing the source code for the service"
        
  workflow_call:
    inputs:
      project-id:
        required: true
        type: string
        description: GCP Project Identification
      service-name:
        required: false
        type: string
        description: Name of the service
        default: questionnaires-service
      cloud-region:
        required: false
        type: string
        description: Valid GCP Cloud Region
        default: europe-southwest1
      image-name:
        required: true
        description: "Image name to deploy"
        type: string
      github-org:
        required: true
        type: string
        description: "The GitHub organization containing the source code for the service"
      github-service-repository:
        required: true
        type: string
        description: "The repository containing the source code for the service"
    secrets:
      GCP_SA_KEY:
        required: true
      APIKEY_IOS:
        required: true
      APIKEY_ANDROID:
        required: true

env:
  REGION: europe-southwest1
  REPOSITORY: services
  SECRET_NAME: firebase-credentials
  FIREBASE_PROJECT_ID: phonic-altar-450817-q4

jobs:
  Deploy:
    runs-on: ubuntu-latest

    steps:
    - name: Authenticate to Google Cloud
      uses: google-github-actions/auth@v2
      with:
        credentials_json: ${{ secrets.GCP_SA_KEY }}

    - name: Set up Cloud SDK
      uses: google-github-actions/setup-gcloud@v2

    - name: Configure Docker for Artifact Registry
      run: gcloud auth configure-docker ${{ env.REGION }}-docker.pkg.dev

    - name: Deploy to Cloud Run
      run: |
        echo "Deploying image ${{ inputs.image-name }} to Cloud Run service ${{ inputs.service-name }} in project ${{ inputs.project-id }} and region ${{ inputs.cloud-region }}"
        gcloud run deploy ${{ inputs.service-name }} \
          --image=${{ inputs.image-name }} \
          --platform=managed \
          --region=${{ inputs.cloud-region }} \
          --allow-unauthenticated \
          --port=8080 \
          --memory=1Gi \
          --cpu=1 \
          --set-env-vars="SUPPORTERSAPP_IOS_APIKEY=${{ secrets.APIKEY_IOS }}" \
          --set-env-vars="SUPPORTERSAPP_ANDROID_APIKEY=${{ secrets.APIKEY_ANDROID }}" \
          --set-env-vars="GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-key.json,FIREBASE_PROJECT_ID=${{ env.FIREBASE_PROJECT_ID }}" \
          --update-secrets="/app/firebase-key.json=${{ env.SECRET_NAME }}:latest" \
          --project=${{ inputs.project-id }}
</file>

<file path=".github/workflows/cicd-cloud-run-service.yml">
name: Build and Push
run-name: "Build & Push ${{ inputs.service-name }}"

on:
  # push:
  #   branches: [ main ]
  workflow_dispatch:
    inputs:
      service-name:
        type: string
        description: "The name identifying the service in the Cloud Run console"
        default: events-service
      build-mode:
        type: choice
        description: "The build mode to use for the Docker image"
        options:
          - jvm
          - native
        default: native
      service-repository:
        type: string
        description: "The repository containing the source code for the service"
        
env:
  PROJECT_ID: phonic-altar-450817-q4
  REGION: europe-southwest1
  REPOSITORY: services
  IMAGE_NAME: europe-southwest1-docker.pkg.dev/phonic-altar-450817-q4/services/${{ inputs.service-name }}
  SECRET_NAME: firebase-credentials
  FIREBASE_PROJECT_ID: phonic-altar-450817-q4
  GITHUB_ORG: supporterApp

jobs:
  build:
    runs-on: ubuntu-latest
    name: Build service
    outputs:
      image-name: ${{ steps.buildDockerImage.outputs.image-name }}
      service-name: ${{ steps.buildDockerImage.outputs.service-name }}
      project-id: ${{ steps.buildDockerImage.outputs.project-id }}
      cloud-region: ${{ steps.buildDockerImage.outputs.cloud-region }}
      service-repository: ${{ inputs.service-repository }}
      github-org: ${{ env.GITHUB_ORG }}      
    steps:

      - name: Decode key
        id: key
        run: |
          KEY=$(echo "${{ secrets.APP_PRIVATE_KEY_B64 }}" | base64 -d)
          echo "value<<EOF" >> $GITHUB_OUTPUT
          echo "$KEY" >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT

      - name: Create GitHub App token
        id: app-token
        uses: actions/create-github-app-token@v1
        with:
          app-id: ${{ secrets.APP_ID }}
          private-key: ${{ secrets.APP_PRIVATE_KEY }}
          owner: ${{ env.GITHUB_ORG }}
          repositories: ${{ inputs.service-repository }}

      - name: Checkout source code
        uses: actions/checkout@v4
        with:
          repository: ${{ env.GITHUB_ORG }}/${{ inputs.service-repository }}
          token: ${{ steps.app-token.outputs.token }}
          path: ./source

      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.GCP_SA_KEY }}

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Build and package
        run: |
          if [ "${{ inputs.build-mode }}" = "native" ]; then
            mvn clean package \
              -Dquarkus.native.enabled=true \
              -Dquarkus.native.container-build=true \
            -Dquarkus.native.container-runtime-options=--platform=linux/amd64
          else
            mvn -B -f pom.xml clean package
          fi

      - name: Set up Cloud SDK
        uses: google-github-actions/setup-gcloud@v2

      - name: Configure Docker for Artifact Registry
        run: gcloud auth configure-docker ${{ env.REGION }}-docker.pkg.dev

      - name: Build Docker image
        id: buildDockerImage
        run: |
          if [ "${{ inputs.build-mode }}" = "native" ]; then
            DOCKERFILE="src/main/docker/Dockerfile.native-micro"
          else
            DOCKERFILE="src/main/docker/Dockerfile.jvm"
          fi
          echo "dockerfile=$DOCKERFILE" >> $GITHUB_OUTPUT
          docker build \
            -f $DOCKERFILE \
            --build-arg GOOGLE_PROJECT_ID="${{ env.PROJECT_ID }}" \
            --build-arg SUPPORTERSAPP_IOS_APIKEY="${{ secrets.APIKEY_IOS }}" \
            --build-arg SUPPORTERSAPP_ANDROID_APIKEY="${{ secrets.APIKEY_ANDROID }}" \
            --platform=linux/amd64 \
            -t ${{ env.IMAGE_NAME }}:${{ github.sha }} .
          echo "image-name=${{ env.IMAGE_NAME }}:${{ github.sha }}" >> $GITHUB_OUTPUT
          echo "project-id=${{ env.PROJECT_ID }}" >> $GITHUB_OUTPUT
          echo "service-name=${{ inputs.service-name }}" >> $GITHUB_OUTPUT
          echo "cloud-region=${{ env.REGION }}" >> $GITHUB_OUTPUT
          echo "service-repository=${{ inputs.service-repository }}" >> $GITHUB_OUTPUT
          echo "github-org=${{ env.GITHUB_ORG }}" >> $GITHUB_OUTPUT
          echo "github-token=${{ steps.app-token.outputs.token }}" >> $GITHUB_OUTPUT
      - name: Push to Artifact Registry
        run: docker push ${{ env.IMAGE_NAME }}:${{ github.sha }}

  deploy:
    name: Deploy to GCP Cloud Run
    needs: build
    uses: ./.github/workflows/cd-cloud-run-service.yaml
    secrets:
      GCP_SA_KEY: ${{ secrets.GCP_SA_KEY }}
      APIKEY_IOS: ${{ secrets.APIKEY_IOS }}
      APIKEY_ANDROID: ${{ secrets.APIKEY_ANDROID }}      
    with:
      image-name: ${{ needs.build.outputs.image-name }}
      project-id: ${{ needs.build.outputs.project-id }}
      service-name: ${{ needs.build.outputs.service-name }}
      cloud-region: ${{ needs.build.outputs.cloud-region }}
      github-org: ${{ needs.build.outputs.github-org }}
      github-service-repository: ${{ needs.build.outputs.service-repository }}
</file>

</files>
