echo -e "${BLUE}3️⃣  Setting up Cloud Scheduler job...${NC}"

SERVICE_URL=$(gcloud run services describe "$SERVICE_NAME" --region "$REGION" --format='value(status.url)')
SCHEDULER_ENDPOINT="${SERVICE_URL}/ingest/weekly"

# Get current project location
SCHEDULER_LOCATION="europe-west1"
INTERNAL_API_KEY=$(gcloud secrets versions access latest --secret="internal-api-key" --project="$PROJECT_ID")
SCHEDULE_UTC_TIME="50 21 * * *"  
# Check if job exists
if gcloud scheduler jobs describe "weekly-match-ingestion" --location "$SCHEDULER_LOCATION" &>/dev/null; then
    echo -e "  ${YELLOW}Updating existing Cloud Scheduler job...${NC}"    
    gcloud scheduler jobs update http "weekly-match-ingestion" \
        --location "$SCHEDULER_LOCATION" \
        --schedule="$SCHEDULE_UTC_TIME" \
        --uri="$SCHEDULER_ENDPOINT" \
        --http-method=POST \
        --message-body='{}' \
        --update-headers="apikey=$INTERNAL_API_KEY"
else
    echo -e "  ${YELLOW}Creating new Cloud Scheduler job...${NC}"
    gcloud scheduler jobs create http "weekly-match-ingestion" \
        --location "$SCHEDULER_LOCATION" \
        --schedule="$SCHEDULE_UTC_TIME" \
        --uri="$SCHEDULER_ENDPOINT" \
        --http-method=POST \
        --message-body='{}' \
        --headers="apikey=$INTERNAL_API_KEY" 2>/dev/null || {
        echo -e "  ${YELLOW}Note: Cloud Scheduler job creation may require manual setup${NC}"
    }
fi

echo -e "${GREEN}✓ Cloud Scheduler job configured${NC}"
echo ""

# Step 4: Summary
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ Deployment complete!${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${YELLOW}🔐 Secrets Deployed to GCP Secret Manager:${NC}"
echo -e "  • football-api-key"
echo -e "  • internal-api-key"
echo -e "  • google-web-api-key"
echo -e "  • auth-email"
echo -e "  • auth-password"
echo -e "  • google-maps-api-key"
echo ""
echo -e "${YELLOW}Service Details:${NC}"
echo -e "  URL:              $SERVICE_URL"
echo -e "  Region:           $REGION"
echo -e "  Project:          $PROJECT_ID"
echo -e "  Status Endpoint:  $SERVICE_URL/health"
echo ""
echo -e "${YELLOW}Scheduled Tasks:${NC}"
echo -e "  Ingestion:        Every Wednesday at 23:55 UTC"
echo -e "  Manual Trigger:   curl -X POST $SCHEDULER_ENDPOINT -H \"apikey: <INTERNAL_API_KEY>\""
echo ""
echo -e "${YELLOW}Next Steps:${NC}"
echo -e "  1. Monitor logs:  gcloud run logs read $SERVICE_NAME --region $REGION --follow"
echo -e "  2. View health:   curl $SERVICE_URL/health"
echo -e "  3. View secrets:  gcloud secrets list --project=$PROJECT_ID"
echo -e "  4. Trigger ingestion (manual): curl -X POST $SCHEDULER_ENDPOINT -H \"apikey: <INTERNAL_API_KEY>\""
echo ""
echo -e "${YELLOW}Security Notes:${NC}"
echo -e "  ✓ Sensitive data stored in GCP Secret Manager"
