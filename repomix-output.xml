#!/bin/bash

######################################
# Jobs Deployment Script             #
# (Builds Docker image and deploys   #
#  both jobs to Cloud Run Jobs)      #
######################################

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"
JOB_NAME_UPDATER="match-updater-job"
JOB_NAME_INGESTION="match-data-ingestion-job"
REGION="${REGION:-europe-southwest1}"
REPOSITORY="${REPOSITORY:-services}"
IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/match-job-image"

# Load environment variables from .env file
if [ -f .env ]; then
    echo -e "${BLUE}ℹ Loading variables from .env file...${NC}"
    set -a
    source .env
    set +a
else
    echo -e "${RED}✗ Error: .env file not found${NC}"
    exit 1
fi

# Validate required environment variables
REQUIRED_VARS=(
    "GCP_PROJECT_ID"
    "EVENTS_MGMT_API_URL"
    "LEAGUES_API_URL"
    "TEAMS_API_URL"
    "VENUES_API_URL"
)

# Validate required secrets
REQUIRED_SECRETS=(
    "API_FOOTBALL_KEY"
    "INTERNAL_API_KEY"
    "GOOGLE_WEB_API_KEY"
    "AUTH_EMAIL"
    "AUTH_PASSWORD"
)

echo -e "${BLUE}ℹ Validating required environment variables...${NC}"
for var in "${REQUIRED_VARS[@]}"; do
    if [ -z "${!var}" ]; then
        echo -e "${RED}✗ Error: $var is not set${NC}"
        exit 1
    fi
done

echo -e "${BLUE}ℹ Validating required secrets exist in Secret Manager...${NC}"
for secret in "${REQUIRED_SECRETS[@]}"; do
    if [[ $secret == "API_FOOTBALL_KEY" ]]; then
      SECRET_NAME=$secret
    else
      SECRET_NAME=$(echo "$secret" | tr '[:upper:]' '[:lower:]' | sed 's/_/-/g')
    fi
    
    if ! gcloud secrets describe "$SECRET_NAME" --project="$PROJECT_ID" &>/dev/null; then
        echo -e "${RED}✗ Error: Secret '$SECRET_NAME' not found in GCP Secret Manager${NC}"
        exit 1
    fi
done
echo -e "${GREEN}✓ All required secrets validated${NC}"

# Optional variables with defaults
HTTP_TIMEOUT="${HTTP_TIMEOUT:-30}"
HTTP_CONNECT_TIMEOUT="${HTTP_CONNECT_TIMEOUT:-10}"
FIRESTORE_COLLECTION_PREFIX="${FIRESTORE_COLLECTION_PREFIX:-ingestion_}"
LEAGUES_TO_INGEST="${LEAGUES_TO_INGEST:-143}"
SEASON_TO_INGEST="${SEASON_TO_INGEST:-2025}"
DAYS_FORWARD="${DAYS_FORWARD:-7}"
FOOTBALL_API_BASE_URL="${FOOTBALL_API_BASE_URL:-https://v3.football.api-sports.io}"

# Common Env Vars for Cloud Run Jobs
ENV_VARS="FOOTBALL_API_BASE_URL=$FOOTBALL_API_BASE_URL,\
EVENTS_MGMT_API_URL=$EVENTS_MGMT_API_URL,\
LEAGUES_API_URL=$LEAGUES_API_URL,\
TEAMS_API_URL=$TEAMS_API_URL,\
VENUES_API_URL=$VENUES_API_URL,\
GCP_PROJECT_ID=$PROJECT_ID,\
FIRESTORE_COLLECTION_PREFIX=$FIRESTORE_COLLECTION_PREFIX,\
LEAGUES_TO_INGEST=$LEAGUES_TO_INGEST,\
SEASON_TO_INGEST=$SEASON_TO_INGEST,\
DAYS_FORWARD=$DAYS_FORWARD,\
HTTP_TIMEOUT=$HTTP_TIMEOUT,\
HTTP_CONNECT_TIMEOUT=$HTTP_CONNECT_TIMEOUT"

# Common Secrets for Cloud Run Jobs
SECRETS_VARS="FOOTBALL_API_KEY=API_FOOTBALL_KEY:latest,\
INTERNAL_API_KEY=internal-api-key:latest,\
GOOGLE_WEB_API_KEY=google-web-api-key:latest,\
AUTH_EMAIL=auth-email:latest,\
AUTH_PASSWORD=auth-password:latest,\
GOOGLE_MAPS_API_KEY=google-maps-api-key:latest"

# Step 1: Configure Docker authentication and build image
echo -e "${BLUE}1  Configuring Docker authentication for Artifact Registry...${NC}"
gcloud auth configure-docker "${REGION}-docker.pkg.dev" --quiet

echo -e "${BLUE}   Building and pushing Docker image to Artifact Registry...${NC}"
BUILD_TIMESTAMP=$(date +%Y%m%d-%H%M%S)
IMAGE_TAG="$IMAGE_NAME:$BUILD_TIMESTAMP"

if docker build --platform linux/amd64 -t "$IMAGE_TAG" -t "$IMAGE_NAME:latest" .; then
    docker push "$IMAGE_TAG" && docker push "$IMAGE_NAME:latest"
    echo -e "${GREEN}✓ Docker image pushed successfully${NC}"
else
    echo -e "${RED}✗ Failed to build or push Docker image${NC}"
    exit 1
fi

# Function to deploy or update Cloud Run Job
deploy_cloud_run_job() {
    local job_name="$1"
    local command="$2"

    echo -e "${BLUE}Deploying Cloud Run Job: ${job_name}...${NC}"
    if gcloud run jobs describe "$job_name" --region "$REGION" &>/dev/null; then
        gcloud run jobs update "$job_name" \
            --image "$IMAGE_NAME:latest" \
            --region "$REGION" \
            --tasks 1 \
            --max-retries 1 \
            --task-timeout 3600s \
            --command uv \
            --args "^|^run|python|-m|${command}" \
            --set-env-vars "$ENV_VARS" \
            --set-secrets "$SECRETS_VARS"
    else
        gcloud run jobs create "$job_name" \
            --image "$IMAGE_NAME:latest" \
            --region "$REGION" \
            --tasks 1 \
            --max-retries 1 \
            --task-timeout 3600s \
            --command uv \
            --args "^|^run|python|-m|${command}" \
            --set-env-vars "$ENV_VARS" \
            --set-secrets "$SECRETS_VARS"
    fi
}

# Step 2: Deploy Match Data Ingestion Job
deploy_cloud_run_job "$JOB_NAME_INGESTION" "src.main"

# Step 3: Deploy Match Status Updater Job
deploy_cloud_run_job "$JOB_NAME_UPDATER" "src.status_updater.main"

# Step 4: Configure Cloud Scheduler to trigger Cloud Run Jobs via REST API
echo -e "${BLUE}4  Configuring Cloud Scheduler jobs...${NC}"
SCHEDULER_LOCATION="europe-west1"
PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)')
SERVICE_ACCOUNT="${PROJECT_NUMBER}-compute@developer.gserviceaccount.com"

configure_scheduler_for_job() {
    local scheduler_name="$1"
    local schedule="$2"
    local job_name="$3"
    
    local run_api_url="https://${REGION}-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/${PROJECT_ID}/jobs/${job_name}:run"

    echo -e "  ${YELLOW}Configuring scheduler: ${scheduler_name}...${NC}"
    if gcloud scheduler jobs describe "$scheduler_name" --location "$SCHEDULER_LOCATION" &>/dev/null; then
        gcloud scheduler jobs update http "$scheduler_name" \
            --location "$SCHEDULER_LOCATION" \
            --schedule="$schedule" \
