<file path="scripts/match-data-ingestion/setup-secrets.sh">
#!/bin/bash

#################################
# Setup GCP Secret Manager      #
# For Match Data Ingestion      #
#################################

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"

# Load environment variables from .env file
if [ -f .env ]; then
    echo -e "${BLUE}ℹ Loading variables from .env file...${NC}"
    set -a
    source .env
    set +a
else
    echo -e "${RED}✗ Error: .env file not found${NC}"
    exit 1
fi

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}Setting up GCP Secret Manager${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "  ${YELLOW}Project ID${NC}: $PROJECT_ID"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Enable Secret Manager API
echo -e "${BLUE}ℹ Enabling Secret Manager API...${NC}"
gcloud services enable secretmanager.googleapis.com --project="$PROJECT_ID"
echo -e "${GREEN}✓ Secret Manager API enabled${NC}"
echo ""

# Define secrets to create (format: "secret-name:ENV_VAR_NAME")
SECRETS="
internal-api-key:INTERNAL_API_KEY
google-web-api-key:GOOGLE_WEB_API_KEY
auth-email:AUTH_EMAIL
auth-password:AUTH_PASSWORD
google-maps-api-key:GOOGLE_MAPS_API_KEY
"

# Create or update secrets
echo -e "${BLUE}Creating/Updating secrets in GCP Secret Manager...${NC}"
echo "$SECRETS" | while IFS=':' read -r secret_name env_var; do
    # Skip empty lines
    [ -z "$secret_name" ] && continue
    
    # Get the environment variable value
    secret_value=$(eval echo "\$$env_var")
    
    if [ -z "$secret_value" ]; then
        echo -e "${YELLOW}⚠  Skipping $secret_name: $env_var is not set${NC}"
        continue
    fi
    
    # Check if secret exists
    if gcloud secrets describe "$secret_name" --project="$PROJECT_ID" &>/dev/null; then
        echo -e "  ${YELLOW}Updating secret${NC}: $secret_name"
        echo -n "$secret_value" | gcloud secrets versions add "$secret_name" \
            --data-file=- \
            --project="$PROJECT_ID"
    else
        echo -e "  ${YELLOW}Creating secret${NC}: $secret_name"
        echo -n "$secret_value" | gcloud secrets create "$secret_name" \
            --data-file=- \
            --replication-policy="automatic" \
            --project="$PROJECT_ID"
    fi
    echo -e "    ${GREEN}✓ $secret_name${NC}"
done
echo ""

# Grant Cloud Run service access to secrets
echo -e "${BLUE}ℹ Granting Cloud Run service access to secrets...${NC}"

SERVICE_ACCOUNT=$(gcloud iam service-accounts list \
    --project="$PROJECT_ID" \
    --filter="displayName:Compute Default Service Account" \
    --format='value(email)' | head -1)

if [ -z "$SERVICE_ACCOUNT" ]; then
    # Fallback to default compute service account
    SERVICE_ACCOUNT="${PROJECT_ID/@developer.gserviceaccount.com}@appspot.gserviceaccount.com"
fi

echo -e "  Service Account: $SERVICE_ACCOUNT"

echo "$SECRETS" | while IFS=':' read -r secret_name env_var; do
    # Skip empty lines
    [ -z "$secret_name" ] && continue
    
    # Get the environment variable value
    secret_value=$(eval echo "\$$env_var")
    
    if [ -z "$secret_value" ]; then
        continue
    fi
    
    # Grant the service account access to the secret
    gcloud secrets add-iam-policy-binding "$secret_name" \
        --member="serviceAccount:$SERVICE_ACCOUNT" \
        --role="roles/secretmanager.secretAccessor" \
        --project="$PROJECT_ID" \
        --quiet &>/dev/null
    
    echo -e "    ${GREEN}✓ Granted access to $secret_name${NC}"
done
echo ""

# Display summary
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ Secrets setup complete!${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# List created secrets
echo -e "${YELLOW}Secrets created/updated in GCP Secret Manager:${NC}"
for secret_name in "${!SECRETS[@]}"; do
    echo -e "  • $secret_name"
done
echo ""

echo -e "${YELLOW}Next steps:${NC}"
echo -e "  1. Verify secrets: gcloud secrets list --project=$PROJECT_ID"
echo -e "  2. Deploy the service: ./deployment.sh"
echo ""
</file>

<file path="scripts/post-match-events/deploy-post-match-events.sh">
#!/bin/bash
# deploy-post-match-events.sh
# Deploys the post-match-events Cloud Run Job
#
# Usage: ./deploy-post-match-events.sh [--skip-apis] [--skip-build] [--skip-secret-sync]

set -o pipefail

# Colors
readonly GREEN='\033[0;32m' YELLOW='\033[1;33m' RED='\033[0;31m' BLUE='\033[0;34m' NC='\033[0m'
info()    { echo -e "${BLUE}ℹ${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC} $*"; }
error()   { echo -e "${RED}✗${NC} $*" >&2; }

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${ENV_FILE:-${SCRIPT_DIR}/.env}"

load_env_file() {
  local env_file="$1"
  local line key value

  [ -f "$env_file" ] || return 0

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^export[[:space:]]+ ]] && line="${line#export }"
    [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue

    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"

    if [[ "$value" =~ ^\"(.*)\"$ ]]; then
      value="${BASH_REMATCH[1]}"
    elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi

    if [ -z "${!key+x}" ]; then
      printf -v "$key" '%s' "$value"
      export "$key"
    fi
  done < "$env_file"
}

load_env_file "$ENV_FILE"
if [ -f "$ENV_FILE" ]; then
  info "Loaded deployment variables from ${ENV_FILE}"
else
  warn "No .env file found; using shell environment and script defaults"
fi

# ============================================================================
# Configuration
# ============================================================================

readonly PROJECT_ID="${PROJECT_ID:-${GOOGLE_CLOUD_PROJECT:-${GCP_PROJECT:-phonic-altar-450817-q4}}}"
readonly REGION="${REGION:-europe-southwest1}"
readonly REGION_DEPLOYMENT="${REGION_DEPLOYMENT:-europe-west1}"
readonly REPOSITORY="${REPOSITORY:-services}"
readonly JOB_NAME="post-match-events"
readonly IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${JOB_NAME}"
readonly SERVICE_ACCOUNT="${SERVICE_ACCOUNT:-${PROJECT_ID}@appspot.gserviceaccount.com}"
readonly CLOUD_TASKS_PROJECT_ID="${CLOUD_TASKS_PROJECT_ID:-${PROJECT_ID}}"
readonly CLOUD_TASKS_LOCATION="${CLOUD_TASKS_LOCATION:-${REGION_DEPLOYMENT}}"
readonly POLL_CLOSE_QUEUE="${POLL_CLOSE_QUEUE:-${CLOUD_TASKS_QUEUE:-poll-close-tasks}}"
readonly CLOUD_TASKS_QUEUE="${CLOUD_TASKS_QUEUE:-${POLL_CLOSE_QUEUE}}"
readonly CLOUD_TASKS_BASE="${CLOUD_TASKS_BASE:-https://cloudtasks.googleapis.com/v2}"
readonly CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL="${CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL:-${SERVICE_ACCOUNT}}"
readonly CLOUD_TASK_OIDC_SERVICE_ACCOUNT="${CLOUD_TASK_OIDC_SERVICE_ACCOUNT:-${CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL}}"
readonly NODE_ENV="${NODE_ENV:-production}"
readonly ACTION="${ACTION:-create_event_poll}"
readonly BLOG_POST_OUTPUT_DIR="${BLOG_POST_OUTPUT_DIR:-blog-posts}"
readonly GEMINI_MODEL="${GEMINI_MODEL:-gemini-2.0-flash}"
readonly POLL_CLOSE_DELAY_SECONDS="${POLL_CLOSE_DELAY_SECONDS:-86400}"
readonly JOB_MEMORY="512Mi"
readonly JOB_CPU="1"
readonly JOB_TIMEOUT="10m"

# Secret Manager secret names → env var names exposed to the job
# Format: SECRET_NAME:ENV_VAR_NAME
readonly SECRETS=(
  "API_FOOTBALL_KEY:FOOTBALL_API_KEY"
  "gemini-api-key:GEMINI_API_KEY"
  "internal-api-key:SERVICES_API_KEY"
  "google-web-api-key:FIREBASE_WEB_API_KEY"
  "auth-email:ADMIN_EMAIL"
  "auth-password:ADMIN_PASSWORD"
)

readonly RUNTIME_ENV_VARS=(
  "NODE_ENV"
  "ACTION"
  "EVENT_ID"
  "BLOG_POST_OUTPUT_DIR"
  "FOOTBALL_API_BASE"
  "GEMINI_MODEL"
  "POLLS_API_BASE"
  "INTERMEDIARY_SERVICE_BASE"
  "QUESTIONNAIRES_BASE"
  "TEAMS_BASE"
  "PROJECT_ID"
  "REGION_DEPLOYMENT"
  "CLOUD_TASKS_BASE"
  "CLOUD_TASKS_PROJECT_ID"
  "CLOUD_TASKS_LOCATION"
  "CLOUD_TASKS_QUEUE"
  "CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL"
  "CLOUD_TASK_OIDC_SERVICE_ACCOUNT"
  "POLL_CLOSE_DELAY_SECONDS"
)

SKIP_APIS=false
SKIP_BUILD=false
SYNC_SECRETS=true

build_runtime_env_mappings() {
  local mappings="" name value

  for name in "${RUNTIME_ENV_VARS[@]}"; do
    [ -n "${!name+x}" ] || continue
    value="${!name}"
    [ -n "$value" ] || continue

    if [[ "$value" == *"|"* ]]; then
      error "Environment variable ${name} contains '|', which cannot be used with the gcloud delimiter"
      exit 1
    fi

    mappings="${mappings}|${name}=${value}"
  done

  [ -n "$mappings" ] && echo "^|^${mappings#|}"
}

build_secret_mappings() {
  local mappings="" entry secret_name env_var

  for entry in "${SECRETS[@]}"; do
    secret_name="${entry%%:*}"
    env_var="${entry##*:}"
    mappings="${mappings}${env_var}=${secret_name}:latest,"
  done

  echo "${mappings%,}"
}

sync_secret_from_env() {
  local secret_name="$1"
  local env_var="$2"
  local value="${!env_var:-}"
  local current_value

  if [ -z "$value" ]; then
    warn "No local value for ${env_var}; leaving Secret Manager secret ${secret_name} unchanged"
    return 0
  fi

  if gcloud secrets describe "$secret_name" --project="$PROJECT_ID" &>/dev/null; then
    current_value="$(gcloud secrets versions access latest --secret="$secret_name" --project="$PROJECT_ID" 2>/dev/null || true)"
    if [ "$current_value" = "$value" ]; then
      info "Secret already up to date: ${secret_name}"
      return 0
    fi

    printf '%s' "$value" | gcloud secrets versions add "$secret_name" \
      --data-file=- \
      --project="$PROJECT_ID" \
      --quiet >/dev/null \
      && success "Secret version added: ${secret_name}" \
      || { error "Could not update secret ${secret_name}"; exit 1; }
  else
    printf '%s' "$value" | gcloud secrets create "$secret_name" \
      --replication-policy="automatic" \
      --data-file=- \
      --project="$PROJECT_ID" \
      --quiet >/dev/null \
      && success "Secret created: ${secret_name}" \
      || { error "Could not create secret ${secret_name}"; exit 1; }
  fi
}

# ============================================================================
# Parse flags
# ============================================================================

for arg in "$@"; do
  case $arg in
    --skip-apis)        SKIP_APIS=true ;;
    --skip-build)       SKIP_BUILD=true ;;
    --skip-secret-sync) SYNC_SECRETS=false ;;
    -h|--help)
      echo "Usage: $0 [--skip-apis] [--skip-build] [--skip-secret-sync]"
      echo "  --skip-apis         Skip API enablement"
      echo "  --skip-build        Skip Docker build (reuse existing image)"
      echo "  --skip-secret-sync  Do not create/update Secret Manager values from .env"
      exit 0 ;;
    *)
      error "Unknown argument: $arg"
      exit 1 ;;
  esac
done

# ============================================================================
# APIs
# ============================================================================

if [ "$SKIP_APIS" = false ]; then
  info "Enabling required APIs..."
  gcloud services enable \
    run.googleapis.com \
    cloudbuild.googleapis.com \
    artifactregistry.googleapis.com \
    firestore.googleapis.com \
    cloudtasks.googleapis.com \
    secretmanager.googleapis.com \
    --project="$PROJECT_ID" --quiet
  success "APIs enabled"
else
  warn "Skipping API enablement"
fi

# ============================================================================
# Cloud Tasks queue for delayed poll closing
# ============================================================================

if gcloud tasks queues describe "$POLL_CLOSE_QUEUE" \
  --location="$CLOUD_TASKS_LOCATION" \
  --project="$PROJECT_ID" &>/dev/null; then
  info "Cloud Tasks queue already exists: ${POLL_CLOSE_QUEUE}"
else
  info "Creating Cloud Tasks queue: ${POLL_CLOSE_QUEUE}..."
  gcloud tasks queues create "$POLL_CLOSE_QUEUE" \
    --location="$CLOUD_TASKS_LOCATION" \
    --project="$PROJECT_ID" \
    --quiet || { error "Cloud Tasks queue creation failed"; exit 1; }
  success "Cloud Tasks queue created: ${POLL_CLOSE_QUEUE}"
fi

# ============================================================================
# Secret Manager — sync values from .env or shell environment
# ============================================================================

if [ "$SYNC_SECRETS" = true ]; then
  info "Syncing Secret Manager values from deployment environment..."
  for entry in "${SECRETS[@]}"; do
    SECRET_NAME="${entry%%:*}"
    ENV_VAR="${entry##*:}"
    sync_secret_from_env "$SECRET_NAME" "$ENV_VAR"
  done
else
  warn "Skipping Secret Manager value sync"
fi

# ============================================================================
# IAM — grant Secret Manager access per secret to the job service account
# ============================================================================

info "Granting secretmanager.secretAccessor per secret to job service account..."
for entry in "${SECRETS[@]}"; do
  SECRET_NAME="${entry%%:*}"
  gcloud secrets add-iam-policy-binding "$SECRET_NAME" \
    --member="serviceAccount:${SERVICE_ACCOUNT}" \
    --role="roles/secretmanager.secretAccessor" \
    --project="$PROJECT_ID" \
    --quiet && success "Access granted: ${SECRET_NAME}" || warn "Could not bind ${SECRET_NAME} — may already exist or check permissions"
done

# ============================================================================
# Build
# ============================================================================

cd "${SCRIPT_DIR}" || { error "Script directory not found"; exit 1; }

if [ ! -d node_modules ] || [ package.json -nt node_modules/.package-lock.json ] 2>/dev/null; then
  info "Installing dependencies..."
  npm install --production --prefer-offline --no-audit || { error "npm install failed"; exit 1; }
else
  info "Dependencies already cached, skipping npm install"
fi

if [ "$SKIP_BUILD" = false ]; then
  info "Building Docker image: ${IMAGE_NAME}..."
  gcloud builds submit \
    --tag "$IMAGE_NAME" \
    --project="$PROJECT_ID" \
    || { error "Docker build failed"; cd "$SCRIPT_DIR"; exit 1; }
  success "Image built: ${IMAGE_NAME}"
else
  warn "Skipping Docker build"
fi

cd "$SCRIPT_DIR"

# ============================================================================
# Deploy Job
# ============================================================================
# Secrets are mounted as env vars directly from Secret Manager.
# Format for --set-secrets: ENV_VAR=SECRET_NAME:version

RUNTIME_ENV_MAPPINGS="$(build_runtime_env_mappings)"
SECRET_MAPPINGS="$(build_secret_mappings)"

JOB_ARGS=(
  --image "$IMAGE_NAME"
  --region "$REGION_DEPLOYMENT"
  --project="$PROJECT_ID"
  --tasks 1
  --max-retries 3
  --task-timeout "$JOB_TIMEOUT"
  --memory "$JOB_MEMORY"
  --cpu "$JOB_CPU"
  --service-account "$SERVICE_ACCOUNT"
)

[ -n "$RUNTIME_ENV_MAPPINGS" ] && JOB_ARGS+=(--set-env-vars "$RUNTIME_ENV_MAPPINGS")
[ -n "$SECRET_MAPPINGS" ] && JOB_ARGS+=(--set-secrets "$SECRET_MAPPINGS")

if gcloud run jobs describe "$JOB_NAME" --region="$REGION_DEPLOYMENT" --project="$PROJECT_ID" &>/dev/null; then
  info "Updating existing Cloud Run Job: ${JOB_NAME}..."
  gcloud run jobs update "$JOB_NAME" "${JOB_ARGS[@]}" || { error "Job update failed"; exit 1; }
else
  info "Creating Cloud Run Job: ${JOB_NAME}..."
  gcloud run jobs create "$JOB_NAME" "${JOB_ARGS[@]}" || { error "Job creation failed"; exit 1; }
fi

success "Job ${JOB_NAME} deployed"

# ============================================================================
# IAM — job invocation
# ============================================================================

info "Granting run.invoker to function service account..."
gcloud run jobs add-iam-policy-binding "$JOB_NAME" \
  --member="serviceAccount:${SERVICE_ACCOUNT}" \
  --role="roles/run.invoker" \
  --region="$REGION_DEPLOYMENT" \
  --project="$PROJECT_ID" \
  --quiet || warn "IAM binding may already exist"

info "Granting datastore.user to job service account..."
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${SERVICE_ACCOUNT}" \
  --role="roles/datastore.user" \
  --quiet || warn "IAM binding may already exist"

info "Granting cloudtasks.enqueuer to job service account..."
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${SERVICE_ACCOUNT}" \
  --role="roles/cloudtasks.enqueuer" \
  --quiet || warn "IAM binding may already exist"

success "IAM permissions set"

# ============================================================================
# Verify
# ============================================================================

info "Verifying deployment..."
gcloud run jobs describe "$JOB_NAME" \
  --region="$REGION_DEPLOYMENT" \
  --project="$PROJECT_ID" \
  --format="table(name,region,template.template.containers[0].image)"

success "Done — ${JOB_NAME} is ready"
</file>

<file path="scripts/query-injector/deploy_cloud_run.sh">
#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${ENV_FILE:-$ROOT_DIR/.env}"

log() {
  printf '\n==> %s\n' "$*"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

load_env_file() {
  if [[ ! -f "$ENV_FILE" ]]; then
    die "Environment file not found: $ENV_FILE"
  fi

  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

require_env() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    die "Set $name in $ENV_FILE or export it before running this script"
  fi
}

join_by_delimiter() {
  local delimiter="$1"
  shift
  local joined=""
  local item

  for item in "$@"; do
    if [[ -z "$joined" ]]; then
      joined="$item"
    else
      joined="${joined}${delimiter}${item}"
    fi
  done

  printf '%s' "$joined"
}

load_env_file

PROJECT_ID="${PROJECT_ID:-}"
REGION="${REGION:-europe-southwest1}"
SERVICE_NAME="${SERVICE_NAME:-query-injector}"
ARTIFACT_REPOSITORY="${ARTIFACT_REPOSITORY:-quiz-generator}"
IMAGE_NAME="${IMAGE_NAME:-football-quiz}"
IMAGE_TAG="${IMAGE_TAG:-$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || date +%Y%m%d%H%M%S)}"
PLATFORM="${PLATFORM:-managed}"
MEMORY="${MEMORY:-512Mi}"
CPU="${CPU:-1}"
TIMEOUT="${TIMEOUT:-300}"
MAX_INSTANCES="${MAX_INSTANCES:-10}"
MIN_INSTANCES="${MIN_INSTANCES:-0}"
INGRESS="${INGRESS:-all}"
ALLOW_UNAUTHENTICATED="${ALLOW_UNAUTHENTICATED:-true}"
GEMINI_SECRET_NAME="${GEMINI_SECRET_NAME:-gemini-api-key}"
GEMINI_SECRET_VERSION="${GEMINI_SECRET_VERSION:-latest}"
INTERNAL_API_KEY_SECRET_NAME="${INTERNAL_API_KEY_SECRET_NAME:-internal-api-key}"
INTERNAL_API_KEY_SECRET_VERSION="${INTERNAL_API_KEY_SECRET_VERSION:-latest}"
API_KEY_SECRET_NAME="${API_KEY_SECRET_NAME:-$INTERNAL_API_KEY_SECRET_NAME}"
API_KEY_SECRET_VERSION="${API_KEY_SECRET_VERSION:-$INTERNAL_API_KEY_SECRET_VERSION}"
FLASK_ENV="${FLASK_ENV:-production}"
PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
FIREBASE_CHECK_REVOKED="${FIREBASE_CHECK_REVOKED:-false}"

require_env PROJECT_ID
require_env QUESTIONNAIRES_SERVICE

require_command gcloud
require_command docker

IMAGE_URL="${REGION}-docker.pkg.dev/${PROJECT_ID}/${ARTIFACT_REPOSITORY}/${IMAGE_NAME}:${IMAGE_TAG}"
LATEST_IMAGE_URL="${REGION}-docker.pkg.dev/${PROJECT_ID}/${ARTIFACT_REPOSITORY}/${IMAGE_NAME}:latest"

log "Using GCP project ${PROJECT_ID} in ${REGION}"
gcloud config set project "$PROJECT_ID" >/dev/null

log "Enabling required Google Cloud APIs"
gcloud services enable \
  artifactregistry.googleapis.com \
  run.googleapis.com \
  secretmanager.googleapis.com

log "Checking required Secret Manager secrets"
gcloud secrets describe "$GEMINI_SECRET_NAME" --project "$PROJECT_ID" >/dev/null
gcloud secrets describe "$INTERNAL_API_KEY_SECRET_NAME" --project "$PROJECT_ID" >/dev/null
gcloud secrets describe "$API_KEY_SECRET_NAME" --project "$PROJECT_ID" >/dev/null

if ! gcloud artifacts repositories describe "$ARTIFACT_REPOSITORY" \
  --location "$REGION" \
  --project "$PROJECT_ID" >/dev/null 2>&1; then
  log "Creating Artifact Registry repository ${ARTIFACT_REPOSITORY}"
  gcloud artifacts repositories create "$ARTIFACT_REPOSITORY" \
    --repository-format=docker \
    --location="$REGION" \
    --description="Football Quiz Generator images"
fi

log "Configuring Docker authentication for Artifact Registry"
gcloud auth configure-docker "${REGION}-docker.pkg.dev" --quiet

PROJECT_NUMBER="$(gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)')"
RUNTIME_SERVICE_ACCOUNT="${CLOUD_RUN_SERVICE_ACCOUNT:-${PROJECT_NUMBER}-compute@developer.gserviceaccount.com}"

log "Granting the Cloud Run runtime service account access to secrets"
for secret_name in "$GEMINI_SECRET_NAME" "$INTERNAL_API_KEY_SECRET_NAME" "$API_KEY_SECRET_NAME"; do
  gcloud secrets add-iam-policy-binding "$secret_name" \
    --project "$PROJECT_ID" \
    --member="serviceAccount:${RUNTIME_SERVICE_ACCOUNT}" \
    --role="roles/secretmanager.secretAccessor" >/dev/null
done

log "Building Docker image from Dockerfile"
docker build \
  --platform linux/amd64 \
  --file "$ROOT_DIR/Dockerfile" \
  --tag "$IMAGE_URL" \
  --tag "$LATEST_IMAGE_URL" \
  "$ROOT_DIR"

log "Pushing Docker image"
docker push "$IMAGE_URL"
docker push "$LATEST_IMAGE_URL"

env_pairs=(
  "GEMINI_BASE_URL=${GEMINI_BASE_URL:-https://generativelanguage.googleapis.com/v1beta/models}"
  "QUESTIONNAIRES_SERVICE=${QUESTIONNAIRES_SERVICE:-https://questionnaires-service-343004725643.europe-southwest1.run.app/}"
  "FLASK_ENV=${FLASK_ENV}"
  "PYTHONUNBUFFERED=${PYTHONUNBUFFERED}"
  "FIREBASE_CHECK_REVOKED=${FIREBASE_CHECK_REVOKED}"
)

if [[ -n "${FIREBASE_PROJECT_ID:-}" ]]; then
  env_pairs+=("FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID}")
fi

env_delimiter='~'
for env_pair in "${env_pairs[@]}"; do
  if [[ "$env_pair" == *"$env_delimiter"* ]]; then
    die "Environment variable value contains unsupported delimiter '$env_delimiter': ${env_pair%%=*}"
  fi
done
env_vars_arg="^${env_delimiter}^$(join_by_delimiter "$env_delimiter" "${env_pairs[@]}")"
secret_vars_arg="GEMINI_API_KEY=${GEMINI_SECRET_NAME}:${GEMINI_SECRET_VERSION},API_KEY=${API_KEY_SECRET_NAME}:${API_KEY_SECRET_VERSION},INTERNAL_API_KEY=${INTERNAL_API_KEY_SECRET_NAME}:${INTERNAL_API_KEY_SECRET_VERSION}"

auth_flag="--allow-unauthenticated"
if [[ "$ALLOW_UNAUTHENTICATED" != "true" ]]; then
  auth_flag="--no-allow-unauthenticated"
fi

deploy_args=(
  run deploy "$SERVICE_NAME"
  "--image=$IMAGE_URL"
  "--platform=$PLATFORM"
  "--region=$REGION"
  "$auth_flag"
  "--service-account=$RUNTIME_SERVICE_ACCOUNT"
  "--set-env-vars=$env_vars_arg"
  "--set-secrets=$secret_vars_arg"
  "--memory=$MEMORY"
  "--cpu=$CPU"
  "--timeout=$TIMEOUT"
  "--max-instances=$MAX_INSTANCES"
  "--min-instances=$MIN_INSTANCES"
  "--ingress=$INGRESS"
)

log "Deploying ${SERVICE_NAME} to Cloud Run"
gcloud "${deploy_args[@]}"

SERVICE_URL="$(gcloud run services describe "$SERVICE_NAME" \
  --platform="$PLATFORM" \
  --region="$REGION" \
  --format='value(status.url)')"

log "Deployment complete"
printf 'Service URL: %s\n' "$SERVICE_URL"
</file>

<file path="scripts/score-computation/deploy-attendee-updates.sh">
#!/bin/bash
# deploy-attendee-updates.sh
# Deploys onAttendeeUpdates Cloud Function and/or its Eventarc triggers
#
# Usage: ./deploy-attendee-updates.sh [function | trigger | all] [--skip-apis]

set -o pipefail

# ============================================================================
# Configuration
# ============================================================================

readonly PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"
readonly SERVICE_REGION="${SERVICE_REGION:-europe-west1}"
readonly DATABASE_REGION="${DATABASE_REGION:-eur3}"
readonly FUNCTION_NAME="onAttendeeUpdates"
readonly RUNTIME="nodejs22"
readonly MEMORY="256MB"
readonly TIMEOUT="60s"
readonly SERVICE_ACCOUNT="${PROJECT_ID}@appspot.gserviceaccount.com"
readonly SERVICE_ACCOUNT_TRIGGERS="${SERVICE_ACCOUNT_TRIGGERS:-343004725643-compute@developer.gserviceaccount.com}"
readonly TRIGGER_MATCH="attendee-updates-match-trigger"
readonly TRIGGER_SONG="attendee-updates-song-trigger"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SKIP_APIS=false

# Colors
readonly GREEN='\033[0;32m' YELLOW='\033[1;33m' RED='\033[0;31m' BLUE='\033[0;34m' NC='\033[0m'
info()    { echo -e "${BLUE}ℹ${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC} $*"; }
error()   { echo -e "${RED}✗${NC} $*" >&2; }

# ============================================================================
# Usage
# ============================================================================

print_usage() {
  cat <<EOF
Usage: $0 [command] [options]

Commands:
  function    Deploy the Cloud Function only
  trigger     Deploy Eventarc triggers only
  all         Deploy function and triggers (default)

Options:
  --skip-apis   Skip API enablement
  -h, --help    Show this help message

Examples:
  ./deploy-attendee-updates.sh all
  ./deploy-attendee-updates.sh function --skip-apis
  ./deploy-attendee-updates.sh trigger
EOF
}

# ============================================================================
# Parse arguments
# ============================================================================

COMMAND="all"

for arg in "$@"; do
  case $arg in
    function|trigger|all) COMMAND="$arg" ;;
    --skip-apis) SKIP_APIS=true ;;
    -h|--help) print_usage; exit 0 ;;
    *)
      error "Unknown argument: $arg"
      print_usage
      exit 1
      ;;
  esac
done

# ============================================================================
# APIs
# ============================================================================

enable_apis() {
  if [ "$SKIP_APIS" = true ]; then
    warn "Skipping API enablement"
    return 0
  fi
  info "Enabling required APIs..."
  gcloud services enable \
    cloudfunctions.googleapis.com \
    eventarc.googleapis.com \
    firestore.googleapis.com \
    pubsub.googleapis.com \
    --project="$PROJECT_ID" --quiet
  success "APIs enabled"
}

# ============================================================================
# Deploy Function
# ============================================================================

deploy_function() {
  info "Deploying Cloud Function: ${FUNCTION_NAME}..."

  cd "${SCRIPT_DIR}/attendee-updates-function" || { error "attendee-updates-function/ directory not found"; exit 1; }

  if [ ! -d node_modules ] || [ package.json -nt node_modules/.package-lock.json ] 2>/dev/null; then
    info "Installing dependencies..."
    npm install --production --prefer-offline --no-audit || { error "npm install failed"; exit 1; }
  else
    info "Dependencies already cached, skipping npm install"
  fi

  gcloud functions deploy "$FUNCTION_NAME" \
    --gen2 \
    --runtime "$RUNTIME" \
    --source . \
    --entry-point "$FUNCTION_NAME" \
    --region "$SERVICE_REGION" \
    --project="$PROJECT_ID" \
    --memory "$MEMORY" \
    --timeout "$TIMEOUT" \
    --no-allow-unauthenticated \
    --trigger-http \
    --set-env-vars "GCP_PROJECT=${PROJECT_ID}" \
    || { error "Function deployment failed"; cd "$SCRIPT_DIR"; exit 1; }

  success "Function ${FUNCTION_NAME} deployed"
  cd "$SCRIPT_DIR"
}

# ============================================================================
# Deploy Triggers
# ============================================================================

deploy_triggers() {
  local function_service
  function_service=$(echo "$FUNCTION_NAME" | tr '[:upper:]' '[:lower:]')

  info "Creating Eventarc trigger: ${TRIGGER_MATCH}..."
  if gcloud eventarc triggers describe "$TRIGGER_MATCH" --location="$DATABASE_REGION" --project="$PROJECT_ID" &>/dev/null; then
    warn "Trigger ${TRIGGER_MATCH} already exists, skipping"
  else
    gcloud eventarc triggers create "$TRIGGER_MATCH" \
      --location="$DATABASE_REGION" \
      --project="$PROJECT_ID" \
      --destination-run-service="$function_service" \
      --destination-run-region="$SERVICE_REGION" \
      --destination-run-path="/" \
      --event-filters="type=google.cloud.firestore.document.v1.written" \
      --event-filters="database=(default)" \
      --event-filters-path-pattern="document=event_match/{eventId}/attendees/{userId}" \
      --event-data-content-type="application/protobuf" \
      --service-account="$SERVICE_ACCOUNT_TRIGGERS" \
      || { error "Failed to create ${TRIGGER_MATCH}"; exit 1; }
    success "Trigger ${TRIGGER_MATCH} created"
  fi

  info "Creating Eventarc trigger: ${TRIGGER_SONG}..."
  if gcloud eventarc triggers describe "$TRIGGER_SONG" --location="$DATABASE_REGION" --project="$PROJECT_ID" &>/dev/null; then
    warn "Trigger ${TRIGGER_SONG} already exists, skipping"
  else
    gcloud eventarc triggers create "$TRIGGER_SONG" \
      --location="$DATABASE_REGION" \
      --project="$PROJECT_ID" \
      --destination-run-service="$function_service" \
      --destination-run-region="$SERVICE_REGION" \
      --destination-run-path="/" \
      --event-filters="type=google.cloud.firestore.document.v1.written" \
      --event-filters="database=(default)" \
      --event-filters-path-pattern="document=event_song/{eventId}/attendees/{userId}" \
      --event-data-content-type="application/protobuf" \
      --service-account="$SERVICE_ACCOUNT_TRIGGERS" \
      || { error "Failed to create ${TRIGGER_SONG}"; exit 1; }
    success "Trigger ${TRIGGER_SONG} created"
  fi

  info "Granting Datastore access to service account..."
  gcloud projects add-iam-policy-binding "$PROJECT_ID" \
    --member="serviceAccount:${SERVICE_ACCOUNT}" \
    --role="roles/datastore.user" \
    --quiet || warn "IAM binding may already exist"
  success "IAM permissions set"
}

# ============================================================================
# Verify
# ============================================================================

verify() {
  info "Verifying deployment..."
  gcloud functions describe "$FUNCTION_NAME" \
    --region="$SERVICE_REGION" --gen2 --project="$PROJECT_ID" \
    --format="value(state)" 2>/dev/null | grep -q "ACTIVE" \
    && success "Function is ACTIVE" || warn "Function state unknown — may still be deploying"

  gcloud eventarc triggers list \
    --location="$DATABASE_REGION" --project="$PROJECT_ID" \
    --filter="name~attendee-updates" \
    --format="table(name,state)"
}

# ============================================================================
# Main
# ============================================================================

enable_apis

case $COMMAND in
  function)
    deploy_function
    ;;
  trigger)
    deploy_triggers
    ;;
  all)
    deploy_function
    deploy_triggers
    ;;
esac

verify
success "Done — command: ${COMMAND}"
</file>

