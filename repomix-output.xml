#!/bin/bash
# deploy-supporter-ranking.sh
# Deploys the supporter-ranking-calculator Cloud Run Job
#
# Usage: ./deploy-supporter-ranking.sh [--skip-apis] [--skip-build]

set -o pipefail

# ============================================================================
# Configuration
# ============================================================================

readonly PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"
readonly REGION="${REGION:-europe-southwest1}"
readonly REGION_DEPLOYMENT="${REGION_DEPLOYMENT:-europe-west1}"
readonly REPOSITORY="${REPOSITORY:-services}"
readonly JOB_NAME="supporter-ranking-calculator"
readonly IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${JOB_NAME}"
readonly SERVICE_ACCOUNT="${PROJECT_ID}@appspot.gserviceaccount.com"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly JOB_MEMORY="512Mi"
readonly JOB_CPU="2"
readonly JOB_TIMEOUT="10m"

SKIP_APIS=false
SKIP_BUILD=false

# Colors
readonly GREEN='\033[0;32m' YELLOW='\033[1;33m' RED='\033[0;31m' BLUE='\033[0;34m' NC='\033[0m'
info()    { echo -e "${BLUE}ℹ${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC} $*"; }
error()   { echo -e "${RED}✗${NC} $*" >&2; }

# ============================================================================
# Parse flags
# ============================================================================

for arg in "$@"; do
  case $arg in
    --skip-apis)  SKIP_APIS=true ;;
    --skip-build) SKIP_BUILD=true ;;
    -h|--help)
      echo "Usage: $0 [--skip-apis] [--skip-build]"
      echo "  --skip-apis    Skip API enablement"
      echo "  --skip-build   Skip Docker build (reuse existing image)"
      exit 0 ;;
    *)
      error "Unknown argument: $arg"
      exit 1 ;;
  esac
done

# ============================================================================
# APIs
# ============================================================================

if [ "$SKIP_APIS" = false ]; then
  info "Enabling required APIs..."
  gcloud services enable \
    run.googleapis.com \
    cloudbuild.googleapis.com \
    artifactregistry.googleapis.com \
    firestore.googleapis.com \
    --project="$PROJECT_ID" --quiet
  success "APIs enabled"
else
  warn "Skipping API enablement"
fi

# ============================================================================
# Build
# ============================================================================

cd "${SCRIPT_DIR}/supporter-ranking-job" || { error "supporter-ranking-job/ directory not found"; exit 1; }

if [ ! -d node_modules ] || [ package.json -nt node_modules/.package-lock.json ] 2>/dev/null; then
  info "Installing dependencies..."
  npm install --production --prefer-offline --no-audit || { error "npm install failed"; exit 1; }
else
  info "Dependencies already cached, skipping npm install"
fi

if [ "$SKIP_BUILD" = false ]; then
  info "Building Docker image: ${IMAGE_NAME}..."
  gcloud builds submit \
    --tag "$IMAGE_NAME" \
    --project="$PROJECT_ID" \
    || { error "Docker build failed"; cd "$SCRIPT_DIR"; exit 1; }
  success "Image built: ${IMAGE_NAME}"
else
  warn "Skipping Docker build"
fi

cd "$SCRIPT_DIR"

# ============================================================================
# Deploy Job
# ============================================================================
# Change the REGION to europe-west1 to deploy in the same region as the Firestore database for lower latency

if gcloud run jobs describe "$JOB_NAME" --region="$REGION_DEPLOYMENT" --project="$PROJECT_ID" &>/dev/null; then
  info "Updating existing Cloud Run Job: ${JOB_NAME}..."
  gcloud run jobs update "$JOB_NAME" \
    --image "$IMAGE_NAME" \
    --region "$REGION_DEPLOYMENT" \
    --project="$PROJECT_ID" \
    --tasks 1 \
    --max-retries 3 \
    --task-timeout "$JOB_TIMEOUT" \
    --memory "$JOB_MEMORY" \
    --cpu "$JOB_CPU" \
    --set-env-vars "NODE_ENV=production" \
    --service-account "$SERVICE_ACCOUNT" \
    || { error "Job update failed"; exit 1; }
else
  info "Creating Cloud Run Job: ${JOB_NAME}..."
  gcloud run jobs create "$JOB_NAME" \
    --image "$IMAGE_NAME" \
    --region "$REGION_DEPLOYMENT" \
    --project="$PROJECT_ID" \
    --tasks 1 \
    --max-retries 3 \
    --task-timeout "$JOB_TIMEOUT" \
    --memory "$JOB_MEMORY" \
    --cpu "$JOB_CPU" \
    --set-env-vars "NODE_ENV=production" \
    --service-account "$SERVICE_ACCOUNT" \
    || { error "Job creation failed"; exit 1; }
fi

success "Job ${JOB_NAME} deployed"

# ============================================================================
# IAM
# ============================================================================

info "Granting run.invoker to function service account..."
gcloud run jobs add-iam-policy-binding "$JOB_NAME" \
  --member="serviceAccount:${SERVICE_ACCOUNT}" \
  --role="roles/run.invoker" \
  --region="$REGION_DEPLOYMENT" \
  --project="$PROJECT_ID" \
  --quiet || warn "IAM binding may already exist"

info "Granting datastore.user to job service account..."
gcloud projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:${SERVICE_ACCOUNT}" \
  --role="roles/datastore.user" \
  --quiet || warn "IAM binding may already exist"

success "IAM permissions set"

# ============================================================================
# Verify
# ============================================================================

info "Verifying deployment..."
gcloud run jobs describe "$JOB_NAME" \
  --region="$REGION_DEPLOYMENT" \
  --project="$PROJECT_ID" \
  --format="table(name,region,template.template.containers[0].image)"

success "Done — ${JOB_NAME} is ready"
</file>

<file path="scripts/score-computation/deployment.sh">
#!/bin/bash
# deployment.sh - Deploy Cloud Run Job, Cloud Function, and Firestore triggers
# Usage: ./deployment.sh [job-function | trigger-resource | service-function | permissions | all] [OPTIONS]
# 
# Author: cafaray
# Purpose: Automated deployment orchestration with logging, error handling, and resource optimization

set -o pipefail

# ============================================================================
# Configuration & Constants
# ============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LOG_FILE="${SCRIPT_DIR}/deployment-$(date +%Y%m%d-%H%M%S).log"
readonly START_TIME=$(date +%s)

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Project Configuration
readonly PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"
readonly REGION="${REGION:-europe-southwest1}"
readonly SERVICE_REGION="${SERVICE_REGION:-europe-west1}"
readonly FUNCTION_NAME="onEventStatusChanged"
readonly JOB_NAME="attendee-score-calculator"
readonly REPOSITORY="${REPOSITORY:-services}"
readonly IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${JOB_NAME}"
readonly SERVICE_ACCOUNT="${PROJECT_ID}@appspot.gserviceaccount.com"
readonly RUNTIME_FUNCTION="nodejs22"
readonly MEMORY_ALLOCATION="256MB"
readonly TIMEOUT_DURATION="540s"
readonly JOB_TIMEOUT="10m"
readonly JOB_MEMORY="512Mi"
readonly JOB_CPU="1"
readonly SUMMARY_BUCKET_NAME="firestore-event-score-summaries"
readonly EVENTARC_TRIGGER_NAME="event-status-pipeline"
readonly DATABASE_REGION="eur3"
readonly SERVICE_ACCOUNT_TRIGGERS="343004725643-compute@developer.gserviceaccount.com"

# Deployment options
declare -A VALID_DEPLOYMENTS=(
    [job-function]=1
    [trigger-resource]=1
    [service-function]=1
    [permissions]=1
    [all]=1
)

# ============================================================================
# Logging Functions
# ============================================================================

log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local formatted_message="[${timestamp}] [${level}] ${message}"
    
    echo -e "${formatted_message}" | tee -a "${LOG_FILE}"
}

log_info() {
    echo -e "${BLUE}ℹ${NC} # $(log INFO "$@")"
}

log_success() {
    echo -e "${GREEN}✓${NC} # $(log SUCCESS "$@")"
}

log_warn() {
    echo -e "${YELLOW}⚠${NC} # $(log WARN "$@")" >&2
}

log_error() {
    echo -e "${RED}✗${NC} # $(log ERROR "$@")" >&2
}

# ============================================================================
# Utility Functions
# ============================================================================

print_usage() {
    cat <<EOF
Usage: $0 [deployment-type] [options]

Deployment Types:
  job-function      Deploy Cloud Run Job (container-based)
  service-function  Deploy Cloud Function (event-driven)
  trigger-resource  Deploy Firestore Eventarc triggers
  permissions       Set up IAM permissions
  all               Deploy everything in sequence

Options:
  --skip-apis       Skip API enablement (speeds up deployment)
  --skip-build      Skip Docker build (use existing image)
  --help, -h        Show this help message

Environment Variables (Optional):
  PROJECT_ID        GCP Project ID (default: phonic-altar-450817-q4)
  REGION            Cloud Run region (default: europe-southwest1)
  SERVICE_REGION    Function region (default: europe-west1)
  REPOSITORY        Artifact Registry repository (default: services)

Examples:
  ./deployment.sh all
  ./deployment.sh job-function --skip-apis
  ./deployment.sh service-function
  REGION=us-central1 ./deployment.sh permissions

EOF
}

print_configuration() {
    log_info "═══════════════════════════════════════════════════════════"
    log_info "Deployment Configuration"
    log_info "═══════════════════════════════════════════════════════════"
    log_info "Project ID:          ${PROJECT_ID}"
    log_info "Cloud Run Region:    ${REGION}"
    log_info "Function Region:     ${SERVICE_REGION}"
    log_info "Job Name:            ${JOB_NAME}"
    log_info "Job Memory:          ${JOB_MEMORY}"
    log_info "Job CPU:             ${JOB_CPU}"
    log_info "Function Name:       ${FUNCTION_NAME}"
    log_info "Function Memory:     ${MEMORY_ALLOCATION}"
    log_info "Image:               ${IMAGE_NAME}"
    log_info "Service Account:     ${SERVICE_ACCOUNT}"
    log_info "Log File:            ${LOG_FILE}"
    log_info "═══════════════════════════════════════════════════════════"
}

elapsed_time() {
    local end_time=$(date +%s)
    local duration=$((end_time - START_TIME))
    printf "%02d:%02d:%02d" $((duration / 3600)) $((duration % 3600 / 60)) $((duration % 60))
}

# ============================================================================
# Pre-flight Checks
# ============================================================================

check_prerequisites() {
    log_info "Running pre-flight checks..."
    
    # Check if gcloud is installed
    if ! command -v gcloud &> /dev/null; then
        log_error "gcloud CLI is not installed. Please install it first."
        return 1
    fi
    
    # Check gcloud version
    local gcloud_version
    gcloud_version=$(gcloud --version 2>/dev/null | head -n 1)
    log_info "  → Detected: ${gcloud_version}"
    
    # Check if authenticated
    if ! gcloud auth list --filter=status:ACTIVE --format="value(account)" &> /dev/null; then
        log_error "Not authenticated with gcloud. Run 'gcloud auth login'"
        return 1
    fi
    
    # Check if project exists and is accessible
    if ! gcloud projects describe "$PROJECT_ID" --project="$PROJECT_ID" &>/dev/null; then
        log_error "Cannot access project: ${PROJECT_ID}"
        return 1
    fi
    log_info "  → Project accessible: ${PROJECT_ID}"
    
    # Check if node/npm is available (for job and function deployments)
    if [[ "$deployment" =~ (job-function|service-function|all) ]]; then
        if ! command -v node &> /dev/null || ! command -v npm &> /dev/null; then
            log_error "Node.js and npm are required for this deployment type"
            return 1
        fi
        local node_version
        node_version=$(node --version)
        log_info "  → Detected Node.js: ${node_version}"
    fi
    
    log_success "All prerequisites met"
    return 0
}

enable_required_apis() {
    if [ "$SKIP_APIS" = "true" ]; then
        log_warn "Skipping API enablement (--skip-apis flag set)"
        return 0
    fi
    
    log_info "Enabling required APIs..."
    
    local apis=(
        "cloudfunctions.googleapis.com"
        "cloudbuild.googleapis.com"
        "run.googleapis.com"
        "firestore.googleapis.com"
        "storage.googleapis.com"
        "artifactregistry.googleapis.com"
        "eventarc.googleapis.com"
        "pubsub.googleapis.com"
    )
    
    for api in "${apis[@]}"; do
        log_info "  → Enabling ${api}..."
        if ! gcloud services enable "$api" --project="$PROJECT_ID" &>/dev/null; then
            log_warn "  ⚠ Failed to enable ${api} (may already be enabled)"
        fi
    done
    
    log_success "API enablement complete"
}

# ============================================================================
# Deployment Functions
# ============================================================================

deploy_job_function() {
    log_info "═══════════════════════════════════════════════════════════"
    log_info "Deploying Cloud Run Job: ${JOB_NAME}"
    log_info "═══════════════════════════════════════════════════════════"
    
    local job_dir="${SCRIPT_DIR}/cloud-run-job"
    
    if [ ! -d "$job_dir" ]; then
        log_error "Directory not found: ${job_dir}"
        return 1
    fi
    
    cd "$job_dir" || return 1
    
    # Optimize: Only install if node_modules doesn't exist or package.json changed
    if [ ! -d "node_modules" ] || [ "package.json" -nt "node_modules/.package-lock.json" ] 2>/dev/null; then
        log_info "Installing dependencies (npm install --production)..."
        if ! npm install --production --prefer-offline --no-audit 2>&1 | tee -a "$LOG_FILE"; then
            log_error "npm install failed"
            cd "$SCRIPT_DIR"
            return 1
        fi
        log_success "Dependencies installed"
    else
        log_info "Dependencies already cached, skipping npm install"
    fi
    
    # Build and push container image
    if [ "$SKIP_BUILD" != "true" ]; then
        log_info "Building Docker image: ${IMAGE_NAME}..."
        log_info "  Estimated build time: 2-5 minutes"
        
        if ! gcloud builds submit \
            --tag "$IMAGE_NAME" \
            --project="$PROJECT_ID" \
            2>&1 | tee -a "$LOG_FILE"; then
            log_error "Docker build failed"
            cd "$SCRIPT_DIR"
            return 1
        fi
        log_success "Docker image built and pushed: ${IMAGE_NAME}"
    else
        log_warn "Skipping Docker build (--skip-build flag set)"
    fi
    
    # Check if job exists
    if gcloud run jobs describe "$JOB_NAME" --region "$SERVICE_REGION" --project="$PROJECT_ID" &>/dev/null; then
        log_info "Updating existing Cloud Run Job..."
        if ! gcloud run jobs update "$JOB_NAME" \
            --image "$IMAGE_NAME" \
            --region "$SERVICE_REGION" \
            --project="$PROJECT_ID" \
            --tasks 1 \
            --max-retries 3 \
            --parallelism 2 \
            --task-timeout "$JOB_TIMEOUT" \
            --set-env-vars "NODE_ENV=production" \
            --service-account "$SERVICE_ACCOUNT" \
            --memory "$JOB_MEMORY" \
            --cpu "$JOB_CPU" \
            2>&1 | tee -a "$LOG_FILE"; then
            log_error "Failed to update Cloud Run Job"
            cd "$SCRIPT_DIR"
            return 1
        fi
        log_success "Cloud Run Job updated"
    else
        log_info "Creating new Cloud Run Job..."
        if ! gcloud run jobs create "$JOB_NAME" \
            --image "$IMAGE_NAME" \
            --region "$SERVICE_REGION" \
            --project="$PROJECT_ID" \
            --tasks 1 \
            --max-retries 3 \
            --parallelism 2 \
            --task-timeout "$JOB_TIMEOUT" \
            --set-env-vars "NODE_ENV=production" \
            --service-account "$SERVICE_ACCOUNT" \
            --memory "$JOB_MEMORY" \
            --cpu "$JOB_CPU" \
            2>&1 | tee -a "$LOG_FILE"; then
            log_error "Failed to create Cloud Run Job"
            cd "$SCRIPT_DIR"
            return 1
        fi
        log_success "Cloud Run Job created"
    fi
    
    cd "$SCRIPT_DIR"
    log_success "Cloud Run Job deployment complete"
    return 0
}

deploy_service_function() {
    log_info "═══════════════════════════════════════════════════════════"
    log_info "Deploying Cloud Function: ${FUNCTION_NAME}"
    log_info "═══════════════════════════════════════════════════════════"
    
    local function_dir="${SCRIPT_DIR}/functions"
    
    if [ ! -d "$function_dir" ]; then
        log_error "Directory not found: ${function_dir}"
        return 1
    fi
    
    cd "$function_dir" || return 1
    
    # Optimize: Only install if node_modules doesn't exist or package.json changed
    if [ ! -d "node_modules" ] || [ "package.json" -nt "node_modules/.package-lock.json" ] 2>/dev/null; then
        log_info "Installing dependencies (npm install --production)..."
        if ! npm install --production --prefer-offline --no-audit 2>&1 | tee -a "$LOG_FILE"; then
            log_error "npm install failed"
            cd "$SCRIPT_DIR"
            return 1
        fi
        log_success "Dependencies installed"
    else
        log_info "Dependencies already cached, skipping npm install"
    fi
    
    log_info "Deploying Cloud Function: ${FUNCTION_NAME}..."
    
    if ! gcloud functions deploy "$FUNCTION_NAME" \
        --gen2 \
        --runtime "$RUNTIME_FUNCTION" \
        --source . \
        --entry-point "$FUNCTION_NAME" \
        --region "$SERVICE_REGION" \
        --project="$PROJECT_ID" \
        --memory "$MEMORY_ALLOCATION" \
        --cpu "2" \
        --timeout "$TIMEOUT_DURATION" \
        --no-allow-unauthenticated \
        --trigger-topic "$EVENTARC_TRIGGER_NAME" \
        --set-env-vars "GCP_PROJECT=${PROJECT_ID},FUNCTION_REGION=${SERVICE_REGION},SUMMARY_BUCKET_NAME=${SUMMARY_BUCKET_NAME}" \
        2>&1 | tee -a "$LOG_FILE"; then
        log_error "Failed to deploy Cloud Function"
        cd "$SCRIPT_DIR"
        return 1
    fi
    
    # Extract and log service name
    local service_name
    service_name=$(gcloud functions describe "$FUNCTION_NAME" \
        --region="$SERVICE_REGION" \
        --project="$PROJECT_ID" \
        --format="value(serviceConfig.service)" 2>/dev/null | grep -o '[^/]*$')
    
    log_success "Cloud Function deployed successfully"
    log_info "  Function Name: ${FUNCTION_NAME}"
    log_info "  Service Name:  ${service_name}"
    
    cd "$SCRIPT_DIR"
    return 0
}

deploy_trigger_resource() {
    log_info "═══════════════════════════════════════════════════════════"
    log_info "Deploying Firestore Eventarc Trigger"
    log_info "═══════════════════════════════════════════════════════════"
    
    log_info "Creating Pub/Sub topic: ${EVENTARC_TRIGGER_NAME}..."
    if ! gcloud pubsub topics create "$EVENTARC_TRIGGER_NAME" \
        --project="$PROJECT_ID" \
        --quiet 2>&1 | grep -v "already exists" | tee -a "$LOG_FILE"; then
        log_info "  → Topic already exists or creation skipped"
    fi
    log_success "Pub/Sub topic ready"
    
    log_info "Creating Eventarc trigger for Firestore events..."
    
    if ! gcloud eventarc triggers create firestore-event-pipeline-trigger \
        --location="$DATABASE_REGION" \
        --project="$PROJECT_ID" \
        --destination-run-service=oneventstatuschanged \
        --destination-run-region="$SERVICE_REGION" \
        --destination-run-path="/" \
        --event-filters="type=google.cloud.firestore.document.v1.updated" \
        --event-filters="database=(default)" \
        --event-filters-path-pattern="document=event_*/{docId}" \
        --event-data-content-type="application/protobuf" \
        --service-account="$SERVICE_ACCOUNT_TRIGGERS" \
        2>&1 | tee -a "$LOG_FILE"; then
        log_warn "Eventarc trigger creation failed (may already exist)"
    fi
    
    log_success "Eventarc trigger deployment complete"
    return 0
}

setup_permissions() {
    log_info "═══════════════════════════════════════════════════════════"
    log_info "Setting up IAM Permissions"
    log_info "═══════════════════════════════════════════════════════════"
    
    log_info "Granting Cloud Run Job invoker permission..."
    if ! gcloud run jobs add-iam-policy-binding "$JOB_NAME" \
        --member "serviceAccount:${SERVICE_ACCOUNT}" \
        --role "roles/run.invoker" \
        --region "$REGION" \
        --project="$PROJECT_ID" \
        --quiet 2>&1 | tee -a "$LOG_FILE"; then
        log_warn "Failed to grant Cloud Run Job invoker role"
    fi
    
    log_info "Granting Datastore and Storage permissions..."
    if ! gcloud projects add-iam-policy-binding "$PROJECT_ID" \
        --member "serviceAccount:${SERVICE_ACCOUNT}" \
        --role "roles/datastore.user" \
        --quiet 2>&1 | tee -a "$LOG_FILE"; then
        log_warn "Failed to grant Datastore permissions"
    fi
    
    if ! gcloud projects add-iam-policy-binding "$PROJECT_ID" \
        --member "serviceAccount:${SERVICE_ACCOUNT}" \
        --role "roles/storage.objectAdmin" \
        --quiet 2>&1 | tee -a "$LOG_FILE"; then
        log_warn "Failed to grant Storage permissions"
    fi
    
    log_success "IAM permissions setup complete"
    return 0
}

# ============================================================================
# Main Script
# ============================================================================

main() {
    local deployment="$1"
    local exit_code=0
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --skip-apis)
                SKIP_APIS=true
                shift
                ;;
            --skip-build)
                SKIP_BUILD=true
                shift
                ;;
            -h|--help)
                print_usage
                exit 0
                ;;
            *)
                deployment="$1"
                shift
                ;;
        esac
    done
    
    # Validate deployment argument
    if [ -z "$deployment" ]; then
        log_error "No deployment type specified"
        print_usage
        return 1
    fi
    
    if [ -z "${VALID_DEPLOYMENTS[$deployment]}" ]; then
        log_error "Invalid deployment type: ${deployment}"
        print_usage
        return 1
    fi
    
    # Display configuration and run checks
    print_configuration
    
    if ! check_prerequisites; then
        log_error "Pre-flight checks failed"
        return 1
    fi
    
    enable_required_apis
    
    # Execute deployment
    case $deployment in
        job-function)
            deploy_job_function || exit_code=1
            ;;
        service-function)
            deploy_service_function || exit_code=1
            ;;
        trigger-resource)
            deploy_trigger_resource || exit_code=1
            ;;
        permissions)
            setup_permissions || exit_code=1
            ;;
        all)
            log_info "Deploying all components in sequence..."
            deploy_service_function || exit_code=1
            deploy_job_function || exit_code=1
            deploy_trigger_resource || exit_code=1
            setup_permissions || exit_code=1
            ;;
    esac
    
    # Print summary
    local elapsed=$(elapsed_time)
    log_info "═══════════════════════════════════════════════════════════"
    if [ $exit_code -eq 0 ]; then
        log_success "Deployment completed successfully (${elapsed})"
    else
        log_error "Deployment completed with errors (${elapsed})"
    fi
    log_info "Log file saved to: ${LOG_FILE}"
    log_info "═══════════════════════════════════════════════════════════"
    
    return $exit_code
}

# Run main function
main "$@"
exit $?
</file>

