echo -e "${BLUE}  Deploying to Cloud Run match updater status-state ...${NC}"
if gcloud run deploy "$SERVICE_NAME_UPDATER" \
    --image "$IMAGE_NAME" \
    --platform managed \
    --region "$REGION" \
    --allow-unauthenticated \
