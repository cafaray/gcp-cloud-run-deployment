#!/bin/bash
# deploy-job.sh - Reference deployment commands for Cloud Run Job and Function
# This file is automatically generated from deployment.sh configuration
# For active deployments, use: ./deployment.sh [job-function | service-function | all]

set -e
set -o pipefail

# ============================================================================
# Configuration (synchronized with deployment.sh)
# ============================================================================

PROJECT_ID="${PROJECT_ID:-phonic-altar-450817-q4}"
REGION="${REGION:-europe-southwest1}"
SERVICE_REGION="${SERVICE_REGION:-europe-west1}"
REPOSITORY="${REPOSITORY:-services}"
JOB_NAME="attendee-score-calculator"
FUNCTION_NAME="onEventStatusChanged"
IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${JOB_NAME}"
SERVICE_ACCOUNT="${PROJECT_ID}@appspot.gserviceaccount.com"
SUMMARY_BUCKET_NAME="firestore-event-score-summaries"
EVENTARC_TRIGGER_NAME="event-status-pipeline"

# Resource allocation
JOB_MEMORY="512Mi"
JOB_CPU="1"
FUNCTION_MEMORY="256MB"
FUNCTION_TIMEOUT="60s"

# ============================================================================
# Cloud Function Deployment
# ============================================================================

deploy_cloud_function() {
    echo "Deploying Cloud Function: ${FUNCTION_NAME}..."
    
    gcloud functions deploy "$FUNCTION_NAME" \
        --gen2 \
        --runtime nodejs22 \
        --source . \
        --entry-point "$FUNCTION_NAME" \
        --region "$SERVICE_REGION" \
        --project="$PROJECT_ID" \
        --memory "$FUNCTION_MEMORY" \
        --timeout "$FUNCTION_TIMEOUT" \
        --no-allow-unauthenticated \
        --trigger-topic="$EVENTARC_TRIGGER_NAME" \
        --set-env-vars "GCP_PROJECT=${PROJECT_ID},FUNCTION_REGION=${SERVICE_REGION},SUMMARY_BUCKET_NAME=${SUMMARY_BUCKET_NAME}"
}

# ============================================================================
# Cloud Run Job Deployment - Create
# ============================================================================

create_cloud_run_job() {
    echo "Creating Cloud Run Job: ${JOB_NAME}..."
    
    gcloud run jobs create "$JOB_NAME" \
        --image "$IMAGE_NAME" \
        --region "$REGION" \
        --project="$PROJECT_ID" \
        --tasks 1 \
        --max-retries 3 \
        --parallelism 2 \
        --task-timeout 10m \
        --memory "$JOB_MEMORY" \
        --cpu "$JOB_CPU" \
        --set-env-vars "NODE_ENV=production" \
        --service-account "$SERVICE_ACCOUNT"
}

# ============================================================================
# Cloud Run Job Deployment - Update
# ============================================================================

update_cloud_run_job() {
    echo "Updating Cloud Run Job: ${JOB_NAME}..."
    
    gcloud run jobs update "$JOB_NAME" \
        --image "$IMAGE_NAME" \
        --region "$REGION" \
        --project="$PROJECT_ID" \
        --tasks 1 \
        --max-retries 3 \
        --parallelism 2 \
        --task-timeout 10m \
        --memory "$JOB_MEMORY" \
        --cpu "$JOB_CPU" \
        --set-env-vars "NODE_ENV=production" \
        --service-account "$SERVICE_ACCOUNT"
}

# Main execution - Choose which to run based on arguments
if [ "$1" = "function" ]; then
    deploy_cloud_function
elif [ "$1" = "job-create" ]; then
    create_cloud_run_job
elif [ "$1" = "job-update" ]; then
    update_cloud_run_job
elif [ "$1" = "all" ]; then
    cd functions && deploy_cloud_function && cd ..
    update_cloud_run_job
else
    echo "Usage: $0 [function | job-create | job-update | all]"
    echo ""
    echo "Note: For production deployments, use ./deployment.sh instead"
    echo "This script is provided as a reference for manual commands."
    exit 1
fi
</file>

